{
  "name": "staging",
  "browser_enabled": false,
  "network_enabled": true,
  "shell_enabled": true,
  "runtime_skill_install_enabled": false,
  "runtime_tool_install_enabled": false,
  "self_evolution_enabled": false,
  "turn_budget": {"max_steps": 36, "max_retries": 5, "max_actions": 64, "timeout_seconds": 180},
  "provider": {
